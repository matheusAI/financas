{
  "name": "financas-site",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:assets && next dev",
    "build:assets": "node dist/build.js",
    "build": "npm run build:assets && prisma generate && next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "serve": "npm run build:assets && next dev --hostname 127.0.0.1 --port 4321",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.15.19",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "dotenv": "^16.4.5",
    "prisma": "^6.9.0",
    "typescript": "^5.8.3"
  }
}
